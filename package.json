{
  "name": "jungle-gaming-challenge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": "22.19.0",
    "npm": "11.6.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "prepare": "node .husky/install.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "check:commit": "npm run format:check && npm run lint && npm run build && npm run test:e2e",
    "audit:lighthouse": "lighthouse http://127.0.0.1:4173/ --config-path=./lighthouse.config.js --output=html --output=json --output-path=./reports/lighthouse/base",
    "release:dry-run": "semantic-release --dry-run"
  },
  "dependencies": {
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.5.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "socket.io-client": "4.8.4",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mswjs/socket.io-binding": "0.2.0",
    "@playwright/test": "1.64.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lighthouse": "13.5.0",
    "msw": "2.15.0",
    "prettier": "3.9.10",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
